+// isBuiltinNamespace is rego.IsBuiltinNamespace.
+// trivy-cdxgen: the rego engine is not linked.
+func isBuiltinNamespace(namespace string) bool {
+	return lo.ContainsBy([]string{"builtin", "defsec", "appshield"}, func(ns string) bool {
+		return strings.HasPrefix(namespace, ns+".")
+	})
