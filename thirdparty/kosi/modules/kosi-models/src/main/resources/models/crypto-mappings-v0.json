{
  "name": "crypto-mappings-v0",
  "description": "The crypto/CBOM mapping table (P8). The collector parses transform strings and algorithm names against these rows and never invents a fact the table does not carry. POPULATION RULE (the P8 gate, R63's rule over a table): every row here must be exercised by at least one crypto-tier fixture, computed as mappings-exercised over mappings-shipped, FAIL below 1.000 — so a row is added to this file only together with the fixture that exercises it. Findings name risk codes; a finding is emitted only when the table row says so, never inferred from a default. `AES` alone is not `AES/ECB/PKCS5Padding` even though the JCA will substitute defaults: the collector reports what the code says and leaves the JCA's defaults to the consumer.",
  "transforms": [
    { "transform": "AES/ECB/PKCS5Padding", "algorithm": "AES", "family": "symmetric", "primitive": "block-cipher", "mode": "ECB", "padding": "PKCS5Padding", "findings": ["ecb-mode"] },
    { "transform": "AES/CBC/PKCS5Padding", "algorithm": "AES", "family": "symmetric", "primitive": "block-cipher", "mode": "CBC", "padding": "PKCS5Padding", "findings": [] },
    { "transform": "AES/GCM/NoPadding", "algorithm": "AES", "family": "symmetric", "primitive": "block-cipher", "mode": "GCM", "padding": "NoPadding", "findings": [] },
    { "transform": "DESede/CBC/PKCS5Padding", "algorithm": "DESede", "family": "symmetric", "primitive": "block-cipher", "mode": "CBC", "padding": "PKCS5Padding", "findings": ["weak-cipher"] },
    { "transform": "RSA/ECB/OAEPWithSHA-256AndMGF1Padding", "algorithm": "RSA", "family": "asymmetric", "primitive": "public-key", "mode": "ECB", "padding": "OAEPWithSHA-256AndMGF1Padding", "findings": [] }
  ],
  "algorithms": [
