{
  "name": "security-pack-v0",
  "description": "The taint model pack. Sources, sinks, passthroughs, sanitizers and effects are DATA: the engine matches callee symbols against these patterns (suffix-segment match, see PatternMatcher) and never hard-codes a rule. Argument-index convention: 0 is the RECEIVER when the callee has one, otherwise the first argument; n is the n-th element of that (receiver,) arguments sequence; -1 is the call's result. Constructor callees render as the class FQN (no <init> suffix). P4 is the first phase that executes this pack, which is why several P0 seed entries carry corrected indexes.",
  "sources": [
    { "pattern": "java.io.BufferedReader.readLine", "category": "untrusted-input" },
    { "pattern": "javax.servlet.http.HttpServletRequest.getParameter", "category": "untrusted-input" },
    { "pattern": "android.content.Intent.getStringExtra", "category": "android-intent" },
    { "pattern": "kotlin.io.readLine", "category": "untrusted-input" }
  ],
  "sinks": [
    { "pattern": "java.lang.ProcessBuilder", "category": "process-exec", "relevantArguments": [0], "severity": "critical" },
    { "pattern": "java.lang.Runtime.exec", "category": "process-exec", "relevantArguments": [1], "receiverType": "java.lang.Runtime", "severity": "critical" },
    { "pattern": "java.sql.Statement.executeQuery", "category": "sql-query", "relevantArguments": [1], "receiverType": "java.sql.Statement", "severity": "critical" },
    { "pattern": "java.sql.Statement.executeUpdate", "category": "sql-query", "relevantArguments": [1], "receiverType": "java.sql.Statement", "severity": "critical" },
    { "pattern": "java.sql.Connection.prepareStatement", "category": "sql-query", "relevantArguments": [1], "receiverType": "java.sql.Connection", "severity": "critical" },
    { "pattern": "java.lang.System.exit", "category": "process-exec", "relevantArguments": [0], "severity": "high" },
    { "pattern": "javax.crypto.Cipher.getInstance", "category": "crypto-asset", "relevantArguments": [0], "severity": "medium" },
    { "pattern": "java.security.MessageDigest.getInstance", "category": "crypto-asset", "relevantArguments": [0], "severity": "medium" },
    { "pattern": "javax.net.ssl.SSLContext.getInstance", "category": "insecure-tls", "relevantArguments": [0], "severity": "high" },
    { "pattern": "java.net.URL", "category": "ssrf", "relevantArguments": [0], "severity": "high" },
    { "pattern": "java.io.FileWriter", "category": "path-traversal", "relevantArguments": [0], "severity": "high" },
    { "pattern": "kotlin.io.println", "category": "log-injection", "relevantArguments": [0], "severity": "medium" },
    { "pattern": "org.slf4j.Logger.info", "category": "log-injection", "relevantArguments": [1], "receiverType": "org.slf4j.Logger", "severity": "medium" },
    { "pattern": "java.io.ObjectInputStream.readObject", "category": "deserialization", "severity": "critical" },
    { "pattern": "com.fasterxml.jackson.databind.ObjectMapper.readValue", "category": "deserialization", "relevantArguments": [1], "receiverType": "com.fasterxml.jackson.databind.ObjectMapper", "severity": "critical" }
  ],
  "passthroughs": [
    { "pattern": "kotlin.text.plus", "category": "iterator-adapter", "flows": [[0, -1], [1, -1]] },
    { "pattern": "kotlin.text.split", "category": "iterator-adapter", "flows": [[0, -1]] },
    { "pattern": "kotlin.collections.split", "category": "iterator-adapter", "flows": [[0, -1]] },
    { "pattern": "kotlin.collections.map", "category": "iterator-adapter", "flows": [[0, -1]] },
    { "pattern": "kotlin.collections.toList", "category": "iterator-adapter", "flows": [[0, -1]] },
    { "pattern": "kotlin.collections.toTypedArray", "category": "iterator-adapter", "flows": [[0, -1]] },
    { "pattern": "kotlin.collections.listOf", "category": "iterator-adapter", "flows": [[0, -1], [1, -1], [2, -1], [3, -1]] },
    { "pattern": "kotlin.collections.mutableListOf", "category": "iterator-adapter", "flows": [[0, -1], [1, -1], [2, -1], [3, -1]] },
    { "pattern": "kotlin.collections.iterator", "category": "iterator-adapter", "flows": [[0, -1]] },
    { "pattern": "kotlin.collections.next", "category": "iterator-adapter", "flows": [[0, -1]] },
    { "pattern": "kotlin.component1", "category": "iterator-adapter", "flows": [[0, -1]] },
    { "pattern": "kotlin.component2", "category": "iterator-adapter", "flows": [[0, -1]] },
    { "pattern": "kotlin.component3", "category": "iterator-adapter", "flows": [[0, -1]] },
    { "pattern": "kotlin.component4", "category": "iterator-adapter", "flows": [[0, -1]] },
    { "pattern": "kotlin.component5", "category": "iterator-adapter", "flows": [[0, -1]] },
    { "pattern": "kotlin.let", "category": "iterator-adapter", "flows": [] },
    { "pattern": "kotlin.run", "category": "iterator-adapter", "flows": [] },
    { "pattern": "kotlin.apply", "category": "iterator-adapter", "flows": [] },
    { "pattern": "kotlin.also", "category": "iterator-adapter", "flows": [] },
    { "pattern": "kotlin.with", "category": "iterator-adapter", "flows": [] },
    { "pattern": "kotlin.use", "category": "iterator-adapter", "flows": [] },
    { "pattern": "kotlin.equals", "category": "iterator-adapter", "flows": [] },
    { "pattern": "kotlin.isNull", "category": "iterator-adapter", "flows": [] },
    { "pattern": "kotlin.collections.contains", "category": "iterator-adapter", "flows": [] },
    { "pattern": "kotlin.collections.hasNext", "category": "iterator-adapter", "flows": [] }
  ],
  "sanitizers": [
    { "pattern": "org.owasp.encoder.Encode.forHtml", "clears": ["xss"] },
    { "pattern": "java.security.MessageDigest.digest", "clears": ["untrusted-input"] }
  ],
  "effects": [
    { "pattern": "kotlin.io.copyTo", "writesToArguments": [1] },
    { "pattern": "java.lang.ProcessBuilder.redirectOutput", "writesToArguments": [1] },
    { "pattern": "kotlin.collections.MutableList.add", "writesToArguments": [1] }
  ]
}
