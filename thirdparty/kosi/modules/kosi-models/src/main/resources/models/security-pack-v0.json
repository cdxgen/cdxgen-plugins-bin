{
  "name": "security-pack-v0",
  "description": "Phase-0 seed pack: the source/sink categories the corpus annotations reference. Phase 3 (kosi-flow) ships the full packs (stdlib, java.base, coroutines, web frameworks, persistence, serialization, Android, crypto, cloud, logging).",
  "sources": [
    { "pattern": "java.io.BufferedReader.readLine", "category": "untrusted-input" },
    { "pattern": "javax.servlet.http.HttpServletRequest.getParameter", "category": "untrusted-input" },
    { "pattern": "android.content.Intent.getStringExtra", "category": "android-intent" },
    { "pattern": "kotlin.io.readLine", "category": "untrusted-input" }
  ],
  "sinks": [
    { "pattern": "java.lang.ProcessBuilder.<init>", "category": "process-exec", "relevantArguments": [1] },
    { "pattern": "java.lang.Runtime.exec", "category": "process-exec", "relevantArguments": [0] },
    { "pattern": "java.sql.Statement.executeQuery", "category": "sql-query", "relevantArguments": [1], "receiverType": "java.sql.Statement" },
    { "pattern": "java.sql.Statement.executeUpdate", "category": "sql-query", "relevantArguments": [1], "receiverType": "java.sql.Statement" },
    { "pattern": "java.sql.Connection.prepareStatement", "category": "sql-query", "relevantArguments": [1] },
    { "pattern": "java.lang.System.exit", "category": "process-exec", "relevantArguments": [0] },
    { "pattern": "javax.crypto.Cipher.getInstance", "category": "crypto-asset", "relevantArguments": [0] },
    { "pattern": "java.security.MessageDigest.getInstance", "category": "crypto-asset", "relevantArguments": [0] },
    { "pattern": "javax.net.ssl.SSLContext.getInstance", "category": "insecure-tls", "relevantArguments": [0] },
    { "pattern": "java.net.URL.<init>", "category": "ssrf", "relevantArguments": [0] },
    { "pattern": "java.io.FileWriter.<init>", "category": "path-traversal", "relevantArguments": [0] },
    { "pattern": "kotlin.io.println", "category": "log-injection", "relevantArguments": [0] },
    { "pattern": "org.slf4j.Logger.info", "category": "log-injection", "relevantArguments": [0] },
    { "pattern": "java.io.ObjectInputStream.readObject", "category": "deserialization" },
    { "pattern": "com.fasterxml.jackson.databind.ObjectMapper.readValue", "category": "deserialization", "relevantArguments": [0] }
  ],
  "passthroughs": [
    { "pattern": "kotlin.text.concat", "category": "iterator-adapter", "flows": [[0, -1]] },
    { "pattern": "kotlin.collections.map", "category": "iterator-adapter", "flows": [[1, -1]] },
    { "pattern": "kotlin.text.plus", "category": "iterator-adapter", "flows": [[0, -1], [1, -1]] }
  ],
  "sanitizers": [
    { "pattern": "org.owasp.encoder.Encode.forHtml", "clears": ["xss"] },
    { "pattern": "java.security.MessageDigest.digest", "clears": ["untrusted-input"] }
  ],
  "effects": [
    { "pattern": "kotlin.io.copyTo", "writesToArguments": [1] },
    { "pattern": "java.lang.ProcessBuilder.redirectOutput", "writesToArguments": [0] }
  ]
}
