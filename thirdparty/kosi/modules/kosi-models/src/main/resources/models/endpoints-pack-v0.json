        { "pattern": "io.ktor.server.routing.head", "methods": ["HEAD"] },
        { "pattern": "io.ktor.server.routing.options", "methods": ["OPTIONS"] },
        { "pattern": "io.ktor.server.routing.route", "methods": [] }
