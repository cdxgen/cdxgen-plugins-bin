    { "pattern": "okhttp3.Request.Builder.url", "kind": "virtual", "protocol": "https", "clientLibrary": "okhttp3", "urlArgument": 0 },
    { "pattern": "retrofit2.Retrofit.Builder.baseUrl", "kind": "virtual", "protocol": "https", "clientLibrary": "retrofit2", "urlArgument": 0 },
