    { "pattern": "org.apache.kafka.clients.producer.KafkaProducer", "kind": "constructor", "protocol": "kafka", "clientLibrary": "kafka-clients", "urlArgument": -1 }
  ],
  "configReaders": [
    { "pattern": "java.util.Properties.getProperty", "argument": 0 },
    { "pattern": "kotlin.system.getenv", "argument": 0 },
    { "pattern": "java.lang.System.getenv", "argument": 0 },
