        { "pattern": "org.springframework.web.reactive.function.server.RouterFunctionDsl.POST", "methods": ["POST"] },
        { "pattern": "org.springframework.web.reactive.function.server.RouterFunctionDsl.PUT", "methods": ["PUT"] },
        { "pattern": "org.springframework.web.reactive.function.server.RouterFunctionDsl.DELETE", "methods": ["DELETE"] },
        { "pattern": "org.springframework.web.reactive.function.server.RouterFunctionDsl.path", "methods": [] }
      ]
    },
