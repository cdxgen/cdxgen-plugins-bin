{
  "name": "endpoints-pack-v0",
  "description": "The framework registry for endpoint, service and URL detection (P7). The detector matches RESOLVED annotation FQNs, DSL callee FQNs and supertype names against these patterns (suffix-segment match, see PatternMatcher) and never hard-codes a framework. A framework the pack does not name is invisible by construction, and every pattern here is validated by a build-time test. annotation FQNs must resolve through the workspace declarations or a real classpath: an unresolved annotation keeps its PSI short name and only matches when the pack pattern is itself a short name, which is never — type identity, not name matching, is what keeps a homonym annotation from becoming an endpoint.",
  "frameworks": [
    {
      "id": "spring-mvc",
      "kind": "annotation",
      "classMarkers": [
        "org.springframework.web.bind.annotation.RestController",
        "org.springframework.web.bind.annotation.Controller"
      ],
      "mappingAnnotations": [
        { "pattern": "org.springframework.web.bind.annotation.GetMapping", "methods": ["GET"] },
        { "pattern": "org.springframework.web.bind.annotation.PostMapping", "methods": ["POST"] },
        { "pattern": "org.springframework.web.bind.annotation.PutMapping", "methods": ["PUT"] },
        { "pattern": "org.springframework.web.bind.annotation.DeleteMapping", "methods": ["DELETE"] },
        { "pattern": "org.springframework.web.bind.annotation.PatchMapping", "methods": ["PATCH"] },
        { "pattern": "org.springframework.web.bind.annotation.RequestMapping", "methods": [] }
      ],
      "pathPrefixAnnotations": [
        "org.springframework.web.bind.annotation.RequestMapping"
      ]
    },
    {
      "id": "spring-webflux",
      "kind": "annotation",
      "classMarkers": [
        "org.springframework.web.bind.annotation.RestController",
        "org.springframework.web.bind.annotation.Controller"
      ],
      "mappingAnnotations": [
        { "pattern": "org.springframework.web.bind.annotation.GetMapping", "methods": ["GET"] },
        { "pattern": "org.springframework.web.bind.annotation.PostMapping", "methods": ["POST"] },
        { "pattern": "org.springframework.web.bind.annotation.PutMapping", "methods": ["PUT"] },
        { "pattern": "org.springframework.web.bind.annotation.DeleteMapping", "methods": ["DELETE"] },
        { "pattern": "org.springframework.web.bind.annotation.RequestMapping", "methods": [] }
      ],
      "pathPrefixAnnotations": [
        "org.springframework.web.bind.annotation.RequestMapping"
      ]
    },
    {
      "id": "spring-webflux-router",
      "kind": "dsl",
      "dslFunctions": [
