<?xml version="1.0" encoding="utf-8"?>
<!-- Negative half inline: a commented-out component is not a component. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fixtures.android">
    <application>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".DeepLinkActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <data android:scheme="kosi" android:host="fixtures.example.com" />
            </intent-filter>
        </activity>
        <!-- <activity android:name=".GhostActivity" android:exported="true" /> -->
        <!-- P28 (R178): a component whose class the analysed tree does not
             hold — a LIBRARY activity, the normal reason. The endpoint is a
             real manifest claim and stays published, marked
             substantiated=false: the manifest says the attack surface
             exists, kosi read none of its behaviour. -->
        <activity android:name="com.example.library.LibraryActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <data android:scheme="kosilib" />
            </intent-filter>
        </activity>
        <receiver android:name=".PackageReceiver" android:exported="false" />
        <service android:name=".SyncService" />
        <provider android:name=".MetaProvider" android:exported="true" />
    </application>
</manifest>
